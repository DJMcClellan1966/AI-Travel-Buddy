{
  "OpenAI": {
    "ApiKey": "your-openai-api-key-here",
    "Model": "gpt-4o",
    "MaxTokens": 4000
  },
  "Maps": {
    "GoogleMapsApiKey": "optional-for-enhanced-features",
    "DefaultMapProvider": "GoogleMaps"
  },
  "Storage": {
    "ItinerariesPath": "./itineraries",
    "ExportsPath": "./exports"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
